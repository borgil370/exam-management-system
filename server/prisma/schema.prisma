// Supabase（托管 PostgreSQL）连接规范：
// 运行时走连接池串（DATABASE_URL，端口 6543），迁移走直连串（DIRECT_URL，端口 5432）
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(cuid())
  name         String
  email        String       @unique
  role         String // "student" | "admin"
  passwordHash String
  createdAt    DateTime     @default(now())
  submissions  Submission[]
}

model Question {
  id            String         @id @default(cuid())
  type          String // "single_choice" | "true_false" | "essay"
  stem          String
  options       Json? // string[] 存 jsonb，简答题为 null
  correctAnswer String? // 简答题没有正确答案
  score         Int
  category      String
  createdAt     DateTime       @default(now())
  examQuestions ExamQuestion[]
  answers       Answer[]
}

model Exam {
  id              String         @id @default(cuid())
  title           String
  description     String
  durationMinutes Int
  startTime       DateTime
  status          String // "draft" | "published" | "closed"
  totalScore      Int
  createdAt       DateTime       @default(now())
  questions       ExamQuestion[]
  submissions     Submission[]
}

// 考试与题目的多对多关联表（显式建表是为了带 sortOrder 保持题目顺序）
model ExamQuestion {
  // 删考试时级联删掉关联行；被考试引用的题目禁止删除（Restrict），避免考试残缺
  exam       Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  examId     String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionId String
  sortOrder  Int

  @@id([examId, questionId])
}

model Submission {
  id             String    @id @default(cuid())
  exam           Exam      @relation(fields: [examId], references: [id], onDelete: Restrict)
  examId         String
  student        User      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentId      String
  status         String // "in_progress" | "pending_review" | "graded"
  objectiveScore Int
  totalScore     Int? // graded 后才有值
  startedAt      DateTime  @default(now())
  submittedAt    DateTime?
  answers        Answer[]

  // 数据库层面保证"同一学生同一考试只能考一次"
  @@unique([examId, studentId])
}

model Answer {
  id           String     @id @default(cuid())
  // 删除提交记录时级联删除作答明细
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String
  question     Question   @relation(fields: [questionId], references: [id], onDelete: Restrict)
  questionId   String
  answer       String
  score        Int? // 简答题复核前为 null
}
